# PrepLens API configuration. Copy to apps/api/.env. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Supabase project URL and the PUBLISHABLE (anon) key. The anon key is meant to be public.
SUPABASE_URL=https://hygafqegwxnrfnhsxmgq.supabase.co
SUPABASE_ANON_KEY=

# SERVER ONLY. Used for the short list in docs/design/08 section 8.6 (rate limiter, guide cache, account deletion).
# Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# The only origin allowed to call this API from a browser. No trailing slash, never "*".
FRONTEND_URL=http://localhost:3100

# Optional: AI prep guides. Without it the guide endpoint answers 503 and everything else works.
GEMINI_API_KEY=
